rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.email == 'empjulio@gmail.com' ||
        (request.auth.token.email != null && request.auth.token.email.matches('.*@drestrellaplasticsurgeon[.]com')) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['staff', 'doctor', 'admin'])
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profiles (staff and patients)
    match /users/{userId} {
      allow read: if isOwner(userId) || isStaff();
      allow create, update: if isOwner(userId) || isStaff();
      allow delete: if isStaff();
    }

    // Patient Clinical & Financial Records (including Base64 PDF Documents, Vital Signs, Labs)
    match /patient_records/{recordId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaff();
    }

    // Consultations & Appointments (Calendar & Booking)
    match /consultations/{consultationId} {
      allow read: if true; // Allows website booking, CRM real-time calendar & pipeline
      allow create, update: if true;
      allow delete: if isStaff();
    }

    // Client Invoices & Surgical Quotes (Financial records & payment status)
    match /quotes/{quoteId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isStaff();
    }

    // CRM Leads & Inquiries
    match /leads/{leadId} {
      allow read: if true; // Allows doctor CRM & live lead pipeline
      allow create, update: if true; // Public lead capture from website, landing page & evaluation modal
      allow delete: if isStaff();
    }
  }
}
